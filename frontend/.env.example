# Local dev: leave empty — Vite proxies /api to localhost:8000
# VITE_API_URL=

# Production (set in Amplify → Environment variables)
# VITE_API_URL=https://stream-catalog.onrender.com

# Optional local-development convenience. Do not put production secrets in VITE_*
# variables: deployed Vite values are public. Hosted users enter the Render
# INGEST_OPERATOR_TOKEN at runtime; it is retained only for the browser tab.
# VITE_INGEST_OPERATOR_TOKEN=your_local_token_here

# Optional local-development convenience. Hosted users enter ADMIN_API_KEY at
# runtime after the API requests it; never publish it as an Amplify VITE_* value.
# VITE_ADMIN_API_KEY=your_local_admin_key_here
